# Server
APP_NAME=smart-cs-fc-agent
DEBUG=true
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
LOCAL_USER_ID=local-user
CHAT_MESSAGE_MAX_LENGTH=8000

# OpenAI-compatible Qwen models
QWEN_API_KEY=your-openai-compatible-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash
# Optional per-node overrides; blank values inherit QWEN_MODEL / QWEN_BASE_URL.
QWEN_SUPERVISOR_MODEL=
QWEN_SUPERVISOR_BASE_URL=
QWEN_KNOWLEDGE_AGENT_MODEL=
QWEN_KNOWLEDGE_AGENT_BASE_URL=
QWEN_TELECOM_AGENT_MODEL=
QWEN_TELECOM_AGENT_BASE_URL=
QWEN_RETAIL_AGENT_MODEL=
QWEN_RETAIL_AGENT_BASE_URL=
QWEN_RESPONSE_WRITER_MODEL=
QWEN_RESPONSE_WRITER_BASE_URL=
QWEN_SAFETY_GUARD_MODEL=
QWEN_SAFETY_GUARD_BASE_URL=
QWEN_MEMORY_MODEL=
QWEN_MEMORY_BASE_URL=
LLM_MAX_CONCURRENCY=20
LLM_QUEUE_CAPACITY=40
LLM_QUEUE_TIMEOUT_SECONDS=15

# Local MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=assist_gen
DB_POOL_MAX_CONNECTIONS=10
DB_POOL_MIN_CACHED=1
DB_POOL_MAX_CACHED=5
DB_POOL_BLOCKING=false
DB_CONNECT_TIMEOUT_SECONDS=5
DB_READ_TIMEOUT_SECONDS=10
DB_WRITE_TIMEOUT_SECONDS=10
# Required outside DEBUG mode. Use a stable, high-entropy secret; rotating it
# requires re-encrypting existing *_cipher values.
PII_ENCRYPTION_KEY=replace-with-a-stable-random-secret

# Local Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_EXPIRE=3600
REDIS_ENABLED=true
REDIS_MAX_CONNECTIONS=20
REDIS_HEALTH_CHECK_INTERVAL=30

# Hybrid retrieval: local fallback or Qdrant dense+sparse hybrid search
VECTOR_STORE_PATH=data/vector_store/faiss_index
EMBEDDING_DIM=1536
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=10
RAG_KEYWORD_MIN_SCORE=0.18
RAG_CANDIDATE_LIMIT=8
KNOWLEDGE_QDRANT_ENABLED=false
KNOWLEDGE_QDRANT_COLLECTION=knowledge_10086_v1
KNOWLEDGE_QDRANT_TIMEOUT_SECONDS=30.0
KNOWLEDGE_EMBEDDING_MODE=external
KNOWLEDGE_RETRIEVAL_MODE=hybrid
KNOWLEDGE_DENSE_VECTOR_NAME=dense
KNOWLEDGE_SPARSE_VECTOR_NAME=sparse
KNOWLEDGE_SPARSE_ENCODER=char_bigram
KNOWLEDGE_QDRANT_DENSE_MODEL=
KNOWLEDGE_QDRANT_SPARSE_MODEL=Qdrant/bm25
KNOWLEDGE_FUSION=rrf
KNOWLEDGE_DENSE_WEIGHT=0.7
KNOWLEDGE_SPARSE_WEIGHT=0.3
KNOWLEDGE_PREFETCH_LIMIT=40
KNOWLEDGE_DENSE_SCORE_THRESHOLD=

# Layered memory (disabled by default)
MEMORY_LAYERED_ENABLED=false
MEMORY_QDRANT_ENABLED=false
MEMORY_WORKER_ENABLED=false
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=customer_memory_v1
QDRANT_TIMEOUT_SECONDS=0.8
MEMORY_CONTEXT_MAX_TOKENS=1800
MEMORY_RECENT_MESSAGES_TOKENS=700
MEMORY_SESSION_SUMMARY_TOKENS=350
MEMORY_EPISODE_TOKENS=350
MEMORY_SEMANTIC_TOKENS=400
MEMORY_RECALL_TOP_K=20
MEMORY_RECALL_MIN_SCORE=0.35
MEMORY_FALLBACK_ITEMS=10
MEMORY_EPISODE_MIN_CONFIDENCE=0.70
MEMORY_PREFERENCE_MIN_CONFIDENCE=0.85
MEMORY_FACT_MIN_CONFIDENCE=0.85
MEMORY_TASK_MIN_CONFIDENCE=0.85
MEMORY_EPISODE_TTL_DAYS=180
MEMORY_PREFERENCE_TTL_DAYS=365
MEMORY_FACT_TTL_DAYS=180
MEMORY_TASK_ACTIVE_TTL_DAYS=90
MEMORY_WORKER_MAX_ATTEMPTS=5
MEMORY_WORKER_LEASE_SECONDS=60
MEMORY_WORKER_POLL_SECONDS=1.0

# Bounded in-process state
AGENT_STATE_TTL_SECONDS=3600
TOOL_CALL_LOG_LIMIT=1000
SKILL_ROOT=skills
SKILL_FILES_ENABLED=true
IDENTITY_HEADER_ENABLED=false
TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128
SESSION_LOCK_TIMEOUT_SECONDS=15
PER_USER_QUEUE_LIMIT=2
ACTION_RECONCILE_WORKER_ENABLED=false
MEMORY_SUMMARY_ELIGIBLE_TURNS=20
MEMORY_SUMMARY_INCREMENT_TURNS=8

# Agent observability (disabled until explicitly enabled)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=local-dev
LANGFUSE_SAMPLE_RATE=1.0
# false keeps prompts, responses, tool arguments, and retrieved content out of Langfuse.
LANGFUSE_CAPTURE_CONTENT=false
# Use a stable random secret so pseudonymous user/session IDs survive API-key rotation.
LANGFUSE_HASH_SALT=replace-with-a-stable-random-secret
