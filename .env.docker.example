# Docker Compose
COMPOSE_PROJECT_NAME=smart-cs-agent
HTTP_PORT=80

# MySQL container credentials. deploy.ps1/deploy.sh replace these placeholders
# with random values on the first run. Never commit the generated .env.docker.
MYSQL_DATABASE=assist_gen
MYSQL_APP_USER=smartcs
MYSQL_APP_PASSWORD=GENERATE_ON_FIRST_RUN
MYSQL_ROOT_PASSWORD=GENERATE_ON_FIRST_RUN

# Application
APP_NAME=smart-cs-agent
DEBUG=false
LOCAL_USER_ID=local-user
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash
PII_ENCRYPTION_KEY=GENERATE_ON_FIRST_RUN

# Optional external embedding service. Leave blank to use local keyword RAG.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Optional Qdrant Cloud integration. Local one-click deployment keeps it off.
KNOWLEDGE_QDRANT_ENABLED=false
MEMORY_LAYERED_ENABLED=false
MEMORY_QDRANT_ENABLED=false
MEMORY_WORKER_ENABLED=false
QDRANT_URL=
QDRANT_API_KEY=

# Optional observability.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_HASH_SALT=GENERATE_ON_FIRST_RUN

